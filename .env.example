# -----------------------------------------------------------------------
# Marko Dashboard — environment variables
# Copy this file to .env.local for local dev, or set these as Render
# "Environment Variables" on the static site service.
# -----------------------------------------------------------------------

# Full URL of the Marko gateway backend (no trailing slash).
# Render example: https://marko-live.onrender.com
# Local dev:      leave empty — Vite proxy handles it automatically.
VITE_API_BASE_URL=https://marko-live.onrender.com

# Set to "true" to run entirely against mock data (no backend needed).
VITE_USE_MOCK=false

# Google OAuth client ID (only needed if OIDC login is enabled).
# VITE_OIDC_CLIENT_ID=
